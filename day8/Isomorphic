import java.util.HashMap;

class Isomorphic {
    public static void main(String[] args) {
        String str1 = "egg";
        String str2 = "ado";
        
        // Edge Case: If lengths don't match, they cannot be isomorphic
        if (str1.length() != str2.length()) {
            System.out.println(false);
            return;
        }

        boolean flag = true;
        HashMap<Character, Character> map = new HashMap<>();

        for (int i = 0; i < str1.length(); i++) {
            char s1 = str1.charAt(i);
            char s2 = str2.charAt(i);

            if (map.containsKey(s1)) {
                // If s1 exists but maps to a different character, it's invalid
                if (map.get(s1) != s2) {
                    flag = false;
                    break;
                }
            } else {
                // If s1 is new, but s2 has already been claimed by another character, it's invalid
                if (map.containsValue(s2)) {
                    flag = false;
                    break;
                }
                map.put(s1, s2);
            }
        }
        System.out.println(flag);
    }
}
