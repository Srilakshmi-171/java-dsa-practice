import java.util.HashMap;

class MinimumSubString {
    public static String minWindow(String s, String t) {
        if (s == null || t == null || s.length() < t.length()) {
            return "";
        }

        // Map to store character frequencies needed from t
        HashMap<Character, Integer> targetMap = new HashMap<>();
        for (char c : t.toCharArray()) {
            targetMap.put(c, targetMap.getOrDefault(c, 0) + 1);
        }

        // Map to keep track of characters in the current window
        HashMap<Character, Integer> windowMap = new HashMap<>();

        int left = 0;
        int right = 0;
        
        // Number of unique characters in t that must match their exact frequency
        int requiredMatches = targetMap.size(); 
        int formedMatches = 0;

        // Array to store window benchmarks: [window_length, left_index, right_index]
        int[] minWindowDetails = {-1, 0, 0};

        while (right < s.length()) {
            char rightChar = s.charAt(right);
            windowMap.put(rightChar, windowMap.getOrDefault(rightChar, 0) + 1);

            // If the current character match count satisfies target requirement
            if (targetMap.containsKey(rightChar) && 
                windowMap.get(rightChar).equals(targetMap.get(rightChar))) {
                formedMatches++;
            }

            // Try and contract the window till the point it ceases to be 'valid'
            while (left <= right && formedMatches == requiredMatches) {
                char leftChar = s.charAt(left);

                // Update our smallest window tracker
                int currentWindowLength = right - left + 1;
                if (minWindowDetails[0] == -1 || currentWindowLength < minWindowDetails[0]) {
                    minWindowDetails[0] = currentWindowLength;
                    minWindowDetails[1] = left;
                    minWindowDetails[2] = right;
                }

                // The character at 'left' position is no longer part of the window
                windowMap.put(leftChar, windowMap.get(leftChar) - 1);
                
                // If removing this character breaks our frequency requirement
                if (targetMap.containsKey(leftChar) && 
                    windowMap.get(leftChar) < targetMap.get(leftChar)) {
                    formedMatches--;
                }

                left++; // Shrink window from the left
            }

            right++; // Expand window to the right
        }

        return minWindowDetails[0] == -1 ? "" : s.substring(minWindowDetails[1], minWindowDetails[2] + 1);
    }

    public static void main(String[] args) {
        String s = "ADOBECODEBANC";
        String t = "ABC";
        System.out.println("Shortest valid substring: " + minWindow(s, t)); // Output: "BANC"
    }
}
