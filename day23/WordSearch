public class WordSearch {
    public boolean exist(char[][] board, String word) {
        if (board == null || board.length == 0 || board[0].length == 0 || word == null || word.length() == 0) {
            return false;
        }

        int rows = board.length;
        int cols = board[0].length;

        // Step 1: Scan the grid to find the first character match
        for (int r = 0; r < rows; r++) {
            for (int c = 0; c < cols; c++) {
                if (board[r][c] == word.charAt(0)) {
                    // Start the depth-first search backtracking
                    if (dfs(board, word, r, c, 0)) {
                        return true;
                    }
                }
            }
        }

        return false;
    }

    private boolean dfs(char[][] board, String word, int row, int col, int index) {
        // Step 2: Success - Every character has been successfully matched
        if (index == word.length()) {
            return true;
        }

        // Step 3: Failure - Boundary checks and character mismatches
        if (row < 0 || row >= board.length || col < 0 || col >= board[0].length || board[row][col] != word.charAt(index)) {
            return false;
        }

        // Step 4: Prevent cell reuse - Save the character and mark as visited
        char temp = board[row][col];
        board[row][col] = '#'; 

        // Step 5: Explore neighbors - Check all 4 directions (Down, Up, Right, Left)
        boolean found = dfs(board, word, row + 1, col, index + 1) ||
                        dfs(board, word, row - 1, col, index + 1) ||
                        dfs(board, word, row, col + 1, index + 1) ||
                        dfs(board, word, row, col - 1, index + 1);

        // Step 6: Backtrack - Restore the cell's original character before returning
        board[row][col] = temp;

        return found;
    }

    // Main method to verify the logic
    public static void main(String[] args) {
        WordSearch solver = new WordSearch();

        // Setup the 3x4 example board from the problem description
        char[][] board = {
            {'A', 'B', 'C', 'E'},
            {'S', 'F', 'C', 'S'},
            {'A', 'D', 'E', 'E'}
        };

        String target = "ABCCED";
        boolean result = solver.exist(board, target);
        
        System.out.println("Does the word '" + target + "' exist in the grid? " + result); 
        // Expected Output: true
    }
}
