public class SearchInRotatedSortedArray  {
    public int search(int[] nums, int target) {
        if (nums == null || nums.length == 0) {
            return -1;
        }

        int left = 0;
        int right = nums.length - 1;

        while (left <= right) {
            int mid = left + (right - left) / 2;

            // Condition 1: Target found
            if (nums[mid] == target) {
                return mid;
            }

            // Condition 2: Left half is sorted
            if (nums[left] <= nums[mid]) {
                // Check if the target falls within the sorted left boundaries
                if (target >= nums[left] && target < nums[mid]) {
                    right = mid - 1; // Search left
                } else {
                    left = mid + 1;  // Search right
                }
            } 
            // Condition 3: Right half must be sorted
            else {
                // Check if the target falls within the sorted right boundaries
                if (target > nums[mid] && target <= nums[right]) {
                    left = mid + 1;  // Search right
                } else {
                    right = mid - 1; // Search left
                }
            }
        }

        // Target not found
        return -1;
    }

    // Quick sanity check
    public static void main(String[] args) {
        Solution solver = new Solution();
        int[] nums = {4, 5, 6, 7, 0, 1, 2};
        int target = 0;
        
        int result = solver.search(nums, target);
        System.out.println("Target index: " + result); // Output: 4
    }
}
