class MaxSoFar {
    public static void main(String[] args) {
        int[] nums = {2, 3, -2, 4};
        
        int max_so_far = nums[0];
        int min_so_far = nums[0];
        int global_max = nums[0];

        for (int i = 1; i < nums.length; i++) {
            // If the current number is negative, swap max and min values
            if (nums[i] < 0) {
                int temp = max_so_far;
                max_so_far = min_so_far;
                min_so_far = temp;
            }

            // The new max/min is either the current number alone, or multiplied by the previous state
            max_so_far = Math.max(nums[i], max_so_far * nums[i]);
            min_so_far = Math.min(nums[i], min_so_far * nums[i]);

            // Update the highest product found anywhere so far
            global_max = Math.max(global_max, max_so_far);
        }
        
        System.out.println(global_max); // Output: 6
    }
}
