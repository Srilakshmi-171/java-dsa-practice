class SearchingIn2D {
    public static void main(String[] args) {
        int[][] matrix = {
                            {1,  3,  5,  7},
                            {10, 11, 16, 20},
                            {23, 30, 34, 60}
                        };
        int target = 16;
        boolean found = false;
        
        int rows = matrix.length;
        int cols = matrix[0].length;
        
        // Treat the 2D grid as a single 1D array from index 0 to (rows * cols - 1)
        int left = 0, right = (rows * cols) - 1;
        
        while (left <= right) {
            int mid = left + (right - left) / 2;
            
            // Map the 1D mid pointer to 2D coordinates [r][c]
            int r = mid / cols;
            int c = mid % cols;
            
            if (matrix[r][c] == target) {
                found = true;
                break;
            } else if (matrix[r][c] > target) {
                right = mid - 1; // Target is smaller, look left
            } else {
                left = mid + 1;  // Target is larger, look right
            }
        }
        
        System.out.println("Target found: " + found);
    }
}
