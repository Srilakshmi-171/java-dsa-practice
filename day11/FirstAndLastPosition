import java.util.Arrays;

class Main {
    public static void main(String[] args) {
        int[] nums = {5, 7, 7, 8, 8, 10};
        int target = 8;

        int[] result = new int[2];
        result[0] = findBound(nums, target, true);  // Find first position
        result[1] = findBound(nums, target, false); // Find last position

        System.out.println(Arrays.toString(result));
    }

    private static int findBound(int[] nums, int target, boolean isFirst) {
        int left = 0, right = nums.length - 1;
        int bound = -1;

        while (left <= right) {
            int mid = left + (right - left) / 2;

            if (nums[mid] == target) {
                bound = mid; // Record the potential answer
                
                if (isFirst) {
                    right = mid - 1; // 🛠️ Twist 1: Keep looking LEFT for the first occurrence
                } else {
                    left = mid + 1;  // 🛠️ Twist 2: Keep looking RIGHT for the last occurrence
                }
            } else if (nums[mid] > target) {
                right = mid - 1;
            } else {
                left = mid + 1;
            }
        }
        return bound;
    }
}

