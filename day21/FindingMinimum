        int[] test1 = {4, 5, 6, 7, 1, 2, 3};
        System.out.println("Min of test1 (Expected 1): " + solver.findMin(test1));

        // Test Case 2: [3, 4, 5, 1, 2]
        int[] test2 = {3, 4, 5, 1, 2};
        System.out.println("Min of test2 (Expected 1): " + solver.findMin(test2));
        
        // Test Case 3: Already sorted / non-rotated array [1, 2, 3, 4, 5]
        int[] test3 = {1, 2, 3, 4, 5};
        System.out.println("Min of test3 (Expected 1): " + solver.findMin(test3));
    }
}
