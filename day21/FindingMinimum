public class FindingMinimum {
    public int findMin(int[] nums) {
        // Edge case: if the array is empty or null, return -1 (or handle as needed)
        if (nums == null || nums.length == 0) {
            return -1;
        }

        int left = 0;
        int right = nums.length - 1;

        // Binary search loop
        while (left < right) {
            int mid = left + (right - left) / 2;

            // Case 1: Middle value is greater than the right value
            if (nums[mid] > nums[right]) {
                // The inflection point (and minimum) must be to the right of mid
                left = mid + 1;
            } 
            // Case 2: Middle value is less than or equal to the right value
            else {
                // The minimum is either at mid or to its left
                right = mid;
            }
        }

        // When left == right, they both point to the minimum element
        return nums[left];
    }

