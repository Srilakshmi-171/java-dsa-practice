import java.util.*;

class SortingSameArray {
    public static void main(String[] args) {
        int[] arr1 = {1, 3, 5, 0, 0, 0};
        int m = 3;
        
        int[] arr2 = {2, 4, 6};
        int n = 3;

        int i = m - 1;
        int j = n - 1;
        int k = m + n - 1;

        // Only loop while both arrays have elements left to compare
        while (i >= 0 && j >= 0) {
            if (arr1[i] > arr2[j]) {
                arr1[k--] = arr1[i--];
            } else {
                arr1[k--] = arr2[j--];
            }
        }

        // If arr1 finishes first, copy the rest of arr2.
        // (If arr2 finishes first, arr1's elements are already where they belong!)
        while (j >= 0) {
            arr1[k--] = arr2[j--];
        }

        // Print the array
        for (int n1 : arr1) {
            System.out.print(n1 + " ");
        }
    }
}
