import java.util.*;

class NextGreaterElement {
    public static void main(String[] args) {
        int[] arr = {4, 5, 2, 10};
        int[] result = new int[arr.length];
        Stack<Integer> stack = new Stack<>();

        // Iterate from right to left
        for (int i = arr.length - 1; i >= 0; i--) {
            
            // Pop elements from the stack that are smaller than or equal to the current element
            while (!stack.isEmpty() && stack.peek() <= arr[i]) {
                stack.pop();
            }

            // If the stack is empty, there is no greater element to the right
            if (stack.isEmpty()) {
                result[i] = -1;
            } else {
                result[i] = stack.peek();
            }

            // Push the current element onto the stack for future comparisons
            stack.push(arr[i]);
        }

        // Print the original array and the resulting next greater elements
        System.out.println("Original Array: " + Arrays.toString(arr));
        System.out.println("Next Greater Elements: " + Arrays.toString(result));
    }
}
