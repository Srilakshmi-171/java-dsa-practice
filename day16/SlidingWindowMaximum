import java.util.*;

class SlidingWindowMaximum {
    public static void main(String[] args) {
        int arr[] = {1, 3, -1, -3, 5, 3, 6, 7};
        int k = 3;
        
        List<Integer> result = new ArrayList<>();
        // Monotonic Deque: stores indices of array elements
        Deque<Integer> deque = new ArrayDeque<>();

        for (int i = 0; i < arr.length; i++) {
            // 1. Remove indices that are out of the current window boundary
            if (!deque.isEmpty() && deque.peekFirst() < i - k + 1) {
                deque.pollFirst();
            }

            // 2. Maintain decreasing order: remove smaller elements from the back
            while (!deque.isEmpty() && arr[deque.peekLast()] <= arr[i]) {
                deque.pollLast();
            }

            // 3. Add current element's index to the back
            deque.addLast(i);

            // 4. Once we have a valid window of size k, the front of deque is the max
            if (i >= k - 1) {
                result.add(arr[deque.peekFirst()]);
            }
        }
        
        System.out.println(result); // Output: [3, 3, 5, 5, 6, 7]
    }
}
