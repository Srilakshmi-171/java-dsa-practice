import java.util.Arrays;

public class FindDuplicate {

    public int findDuplicate(int[] nums) {
        // Phase 1: Finding the intersection point in the cycle
        int tortoise = nums[0];
        int hare = nums[0];
        
        do {
            tortoise = nums[tortoise];       // Moves 1 step: i -> nums[i]
            hare = nums[nums[hare]];         // Moves 2 steps: i -> nums[nums[i]]
        } while (tortoise != hare);
        
        // Phase 2: Finding the entrance to the cycle (the duplicate number)
        tortoise = nums[0];                  // Reset tortoise to the starting point
        while (tortoise != hare) {
            tortoise = nums[tortoise];       // Both move at the same speed of 1 step
            hare = nums[hare];
        }
        
        return tortoise;                     // Or return hare; both point to the duplicate
    }

    public static void main(String[] args) {
        FindDuplicate solver = new FindDuplicate();

        // Test Case 1: Standard case
        int[] nums1 = {1, 3, 4, 2, 2};
        System.out.println("Input:  " + Arrays.toString(nums1));
        System.out.println("Output: " + solver.findDuplicate(nums1)); // Expected: 2
        System.out.println();

        // Test Case 2: Duplicate at the beginning/middle
        int[] nums2 = {3, 1, 3, 4, 2};
        System.out.println("Input:  " + Arrays.toString(nums2));
        System.out.println("Output: " + solver.findDuplicate(nums2)); // Expected: 3
    }
}
