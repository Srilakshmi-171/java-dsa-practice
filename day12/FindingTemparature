import java.util.Arrays;
import java.util.Stack;

class FindingTemparature {
    public static void main(String[] args) {
        int[] temperatures = {73, 74, 75, 71, 69, 72, 76, 73};
        
        int[] result = dailyTemperatures(temperatures);
        
        // Print the final result array
        System.out.println(Arrays.toString(result));
    }

    public static int[] dailyTemperatures(int[] temperatures) {
        int n = temperatures.length;
        int[] result = new int[n]; // Default initialized to 0
        
        // Stack to store the indices of the days
        Stack<Integer> stack = new Stack<>();
        
        for (int i = 0; i < n; i++) {
            // While stack is not empty and current temperature is warmer 
            // than the temperature at the index stored at the top of the stack
            while (!stack.isEmpty() && temperatures[i] > temperatures[stack.peek()]) {
                int prevIndex = stack.pop();
                result[prevIndex] = i - prevIndex; // Calculate days to wait
            }
            
            // Push the current day's index onto the stack
            stack.push(i);
        }
        
        return result;
    }
}
