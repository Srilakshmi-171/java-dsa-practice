import java.util.LinkedList;
import java.util.Queue;

public class IslandCounter {

    public static int numIslands(char[][] grid) {
        // Edge case: check for an empty or null grid
        if (grid == null || grid.length == 0 || grid[0].length == 0) {
            return 0;
        }

        int rows = grid.length;
        int cols = grid[0].length;
        int islandCount = 0;

        // Direction arrays for moving up, down, left, and right
        int[][] directions = {{-1, 0}, {1, 0}, {0, -1}, {0, 1}};

        // Traverse the entire 2D grid
        for (int r = 0; r < rows; r++) {
            for (int c = 0; c < cols; c++) {
                // When a new piece of land is discovered
                if (grid[r][c] == '1') {
                    islandCount++; // Increment the total island count
                    
                    // Start BFS to mark the entire connected island
                    Queue<int[]> queue = new LinkedList<>();
                    queue.offer(new int[]{r, c});
                    grid[r][c] = '0'; // Mark as visited in-place

                    while (!queue.isEmpty()) {
                        int[] curr = queue.poll();
                        int currRow = curr[0];
                        int currCol = curr[1];

                        // Check all 4 horizontal and vertical neighbors
                        for (int[] dir : directions) {
                            int nextRow = currRow + dir[0];
                            int nextCol = currCol + dir[1];

                            // Validate grid boundaries and check if the neighbor is unvisited land
                            if (nextRow >= 0 && nextRow < rows && nextCol >= 0 && nextCol < cols && grid[nextRow][nextCol] == '1') {
                                queue.offer(new int[]{nextRow, nextCol});
                                grid[nextRow][nextCol] = '0'; // Mark as visited immediately upon queuing
                            }
                        }
                    }
                }
            }
        }

        return islandCount;
    }
}


