import java.util.PriorityQueue;

class KthLargestElement {
    public static void main(String[] args) {
        int[] nums = {3, 2, 1, 5, 6, 4};
        int k = 2;
        
        // Create a Min-Heap
        PriorityQueue<Integer> minHeap = new PriorityQueue<>();
        
        // Keep the heap size equal to k
        for (int num : nums) {
            minHeap.add(num);
            if (minHeap.size() > k) {
                minHeap.poll(); // Removes the smallest element in the heap
            }
        }
        
        // The top of the heap is now the k-th largest element
        System.out.println("The " + k + "nd largest element is: " + minHeap.peek());
    }
}
