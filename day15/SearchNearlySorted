public class SearchNearlySorted {
    public int searchNearlySorted(int[] nums, int target) {
        int low = 0;
        int high = nums.length - 1;
        
        while (low <= high) {
            int mid = low + (high - low) / 2;
            
            // 1. Check the midpoint
            if (nums[mid] == target) {
                return mid;
            }
            
            // 2. Check the left neighbour (if it exists within bounds)
            if (mid > low && nums[mid - 1] == target) {
                return mid - 1;
            }
            
            // 3. Check the right neighbour (if it exists within bounds)
            if (mid < high && nums[mid + 1] == target) {
                return mid + 1;
            }
            
            // Narrow the search space, skipping the checked indices
            if (target < nums[mid]) {
                high = mid - 2; // Target is smaller, look left (skip mid and mid-1)
            } else {
                low = mid + 2;  // Target is larger, look right (skip mid and mid+1)
            }
        }
        
        return -1; // Target not found
    }

    public static void main(String[] args) {
        Solution solver = new Solution();
        int[] nums = {10, 3, 40, 20, 50, 80, 70};
        
        System.out.println(solver.searchNearlySorted(nums, 40)); // Output: 2
        System.out.println(solver.searchNearlySorted(nums, 90)); // Output: -1
    }
}
