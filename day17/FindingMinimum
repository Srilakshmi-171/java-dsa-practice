public class FindingMinimum {
    
    // Solves in O(log n) time complexity using Binary Search
    public int findMin(int[] nums) {
        int left = 0;
        int right = nums.length - 1;

        // Loop until the search space reduces to a single element
        while (left < right) {
            int mid = left + (right - left) / 2;

            // If mid element is greater than the rightmost element,
            // the minimum must be in the right half.
            if (nums[mid] > nums[right]) {
                left = mid + 1;
            } 
            // Otherwise, the minimum is at mid or in the left half.
            else {
                right = mid;
            }
        }

        // 'left' and 'right' will converge to the minimum element
        return nums[left];
    }

    // Optional main method to test your solution locally
    public static void main(String[] args) {
        Solution solver = new Solution();
        int[] nums = {4, 5, 6, 7, 0, 1, 2};
        
        System.out.println("The minimum element is: " + solver.findMin(nums));
    }
}
