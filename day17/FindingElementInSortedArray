class FindingElementInSortedArray {
    public static void main(String[] args) {
        int[] nums = {4, 5, 6, 7, 0, 1, 2};
        int k = 4;
        int left = 0, right = nums.length - 1;
        boolean found = false;

        while (left <= right) { // Fixed: Changed < to <=
            int mid = left + (right - left) / 2;

            if (nums[mid] == k) {
                System.out.println(k);
                found = true;
                break;
            }

            // Check if the left half is normally sorted
            if (nums[left] <= nums[mid]) {
                // Check if k lies within the sorted left half
                if (k >= nums[left] && k < nums[mid]) {
                    right = mid - 1;
                } else {
                    left = mid + 1;
                }
            } 
            // Otherwise, the right half must be normally sorted
            else {
                // Check if k lies within the sorted right half
                if (k > nums[mid] && k <= nums[right]) {
                    left = mid + 1;
                } else {
                    right = mid - 1;
                }
            }
        }

        if (!found) {
            System.out.println("Nothing");
        }
    }
}
